# Normalise line endings in the repository; check out per platform.
* text=auto

# Go source must stay LF. gofmt rewrites CRLF back to LF, so a Windows
# checkout with CRLF would make `gofmt -l` report every file as unformatted.
*.go text eol=lf
go.mod text eol=lf
go.sum text eol=lf

# Windows needs CRLF for .cmd/.bat/.ps1 so they run when checked out on Windows.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Shell and config files stay LF everywhere.
*.sh text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.tmpl text eol=lf

# Binaries
*.exe binary
*.dll binary
*.png binary
*.zip binary